# ==========================================================================
# PRODUCTION .env TEMPLATE (VPS). Usage:
#
#   cp .env.prod.example .env
#   # fill every CHANGE_ME_* value, then:
#   docker compose -f docker-compose.prod.yml up -d
#
# This one file is read TWICE: docker compose substitutes ${...} in
# docker-compose.prod.yml AND it is passed to the postiz container as its
# runtime environment (env_file).
# ==========================================================================

# ---- Image / domain ----
POSTIZ_IMAGE=ghcr.io/mahmudph/postiz-app:latest
# Must already resolve to this VPS before Traefik can issue the certificate.
POSTIZ_DOMAIN=postiz.mahmudph.my.id

# ---- Database (read by compose AND the postgres container) ----
# Generate with: openssl rand -hex 24
POSTIZ_DB_USER=postiz
POSTIZ_DB_PASSWORD=CHANGE_ME_postiz_db_password
POSTIZ_DB_NAME=postiz
# Temporal keeps its own postgres. Generate with: openssl rand -hex 24
TEMPORAL_DB_PASSWORD=CHANGE_ME_temporal_db_password

# ---- Postiz ----
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_jwt_secret
MAIN_URL=https://postiz.mahmudph.my.id
FRONTEND_URL=https://postiz.mahmudph.my.id
NEXT_PUBLIC_BACKEND_URL=https://postiz.mahmudph.my.id/api
BACKEND_INTERNAL_URL=http://localhost:3000
TEMPORAL_ADDRESS=temporal:7233
IS_GENERAL=true
# Leave false for the first boot so you can create the admin account, then
# flip to true and recreate the container.
DISABLE_REGISTRATION=false

# ---- Storage (local volume; no S3/R2 needed) ----
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# ---- Misc ----
NX_ADD_PLUGINS=false
API_LIMIT=30
NEXT_PUBLIC_VERSION=vps

# ---- Social platform OAuth apps ----
# Fill only the providers you actually connect. See .env.example for the full
# list (X, LinkedIn, Reddit, Facebook, Threads, YouTube, TikTok, ...).
# X_URL=
# X_API_KEY=
# X_API_SECRET=
